<mujoco model="NEUankle_Ankle">
  <compiler angle="radian" />
  <default class="main">
    <joint armature="1e-05" damping="0.05" limited="true" />
    <geom margin="0.001" rgba="0.8 0.6 0.4 1" />
    <site size="0.001 0.005 0.005" />
    <tendon rgba="0.95 0.3 0.3 1" width="0.005" />
    <default class="muscle">
      <general biasprm="0.75 1.05 -1 200 0.5 1.6 1.5 1.3 1.2 0" biastype="muscle" ctrllimited="true" ctrlrange="0 1" dynprm="0.01 0.04 0 0 0 0 0 0 0 0" dyntype="muscle" gainprm="0.75 1.05 -1 200 0.5 1.6 1.5 1.3 1.2 0" gaintype="muscle" />
    </default>
    <default class="motor">
      <general gainprm="5 0 0 0 0 0 0 0 0 0" />
    </default>
    <default class="coll">
      <geom type="capsule" group="4" contype="1" conaffinity="0" condim="3" rgba="0.8 0.7 .5 1" margin="0.001" material="MatSkin" />
    </default>
    <default class="myo_leg_touch">
      <site type="box" group="3" rgba="0.8 0.2 .2 .4" />
    </default>
  </default>
  <asset>
    <mesh file="mesh/ankle_assem.stl" name="neuankle_ankle_assem" />
    <mesh file="mesh/foot_assem.stl" name="neuankle_foot_assem" />
    <mesh file="mesh/foot_shell.stl" name="neuankle_foot_shell" />
    <mesh file="mesh/generic_socket.stl" name="generic_socket" />
    <mesh file="mesh/double_female_pyramid_adapter.stl" name="pyramid_adapter" />
    <mesh file="mesh/tibia_fibula_trans_r.stl" name="tibia_fibula_trans_r" />
    <material name="MatSkin" specular="0.2" shininess=".1" reflectance="0.5" rgba="0.9 .7 1 1" />
  </asset>
  <worldbody>
    <!-- Attaches to tibia_r; this pos is the socket's offset down the residual limb. -->
    <body name="neuankle_generic_socket" pos="0 -0.275 0.006">
      <inertial pos="0.000000 0.102749 0.005560" quat="0.202485 -0.677495 0.677495 -0.202485" mass="0.2" diaginertia="0.00027383 0.00039542 0.00039543" />
      <geom name="generic_socket" type="mesh" rgba="0.2 0.2 0.2 0.35" mesh="generic_socket" condim="3" contype="1" />

      <body name="neuankle_tibial_pylon" pos="-0.001 0.0065 -0.0135">
        <inertial pos="0.002186 0.001254 0.019585" quat="0.697203 0.044129 0.043309 0.714203" mass="0.2" diaginertia="0.00004074 0.00007610 0.00007844" />
        <geom name="pyramid_adapter_geom" type="mesh" rgba="0.6 0.6 0.6 1" mesh="pyramid_adapter" condim="3" contype="1" />

        <body name="neuankle_ankle_assembly" pos="0.005 -0.088 -0.013">
          <inertial pos="-0.000467 -0.001407 0.031016" quat="0.700131 0.014454 0.025365 0.713418" mass="1.6000" diaginertia="0.00158383 0.00272349 0.00311090" />
          <geom name="neuankle_ankle_assem_geom" type="mesh" rgba="0.706 0.043 0.043 1" mesh="neuankle_ankle_assem" condim="3" contype="1" />
          <site name="r_neuankle_load_force" type="box" pos="0 0.105 0.005" size="0.02 0.003 0.02" euler="0 0 0" group="3" rgba="0.8 0.2 .2 1" />

          <body name="neuankle_foot_assembly" pos="0.03 -0.0457 -0.0045">
            <inertial pos="-0.012288 -0.028418 0.035503" quat="0.944584 -0.309928 0.014152 -0.107263" mass="0.291" diaginertia="0.00027355 0.00076565 0.00083004" />
            <joint name="neuankle_ankle_angle_r" pos="-0.0325 0.028 0.025" axis="0 0 1" range="-0.5236 0.5236" />
            <geom name="neuankle_foot_assem_geom" type="mesh" rgba="0.3 0.3 0.3 1" mesh="neuankle_foot_assem" />
            <site name="r_foot_touch" type="box" pos="0.025 -0.04 0.0" size=".05 .03 .05" euler="0 0 0" class="myo_leg_touch" />

            <body name="neuankle_foot_shell" pos="0.03 -0.022 -0.008">
              <inertial pos="0.003621 -0.012172 0.050867" quat="0.750486 -0.660719 0.014801 -0.001727" mass="0.1" diaginertia="0.00007951 0.00051689 0.00055636" />
              <geom name="neuankle_foot_shell_geom" type="mesh" rgba="0.835 0.667 0.533 0.35" mesh="neuankle_foot_shell" condim="3" contype="1" />
              <site name="r_toes_touch" type="box" pos="0.05 -0.02 0.05" size=".05 .025 .085" euler="0 -1.64 0" class="myo_leg_touch" />
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
</mujoco>
